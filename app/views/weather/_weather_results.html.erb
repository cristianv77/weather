<% error ||= nil %>

<%= turbo_frame_tag "weather_results" do %>
  <% if error %>
    <div class="max-w-md mx-auto mt-8 p-4 bg-red-50 border border-red-200 rounded-md">
      <div class="text-red-800 text-center">
        <%= error %>
      </div>
    </div>
  <% elsif weather_presenter %>
    <%= render "weather/principal_card", weather_presenter: weather_presenter %>
    <%= render "weather/forecast_index", forecast_presenter: forecast_presenter %>
  <% end %>
<% end %>
