<% error ||= nil %>

<%= turbo_frame_tag "weather_results" do %>
  <% if error %>
    <div class="max-w-md mx-auto mt-8 p-4 bg-red-50 border border-red-200 rounded-md">
      <div class="text-red-800 text-center">
        <%= error %>
      </div>
    </div>
  <% elsif weather_record %>
    <%= render "weather/principal_card", current_weather: weather_record.current_weather, city: weather_record.city, state: weather_record.state, country: weather_record.country %>
    <%= render "weather/forecast_index", forecast: weather_record.forecast %>
  <% end %>
<% end %>
