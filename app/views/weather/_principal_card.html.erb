<% weather = current_weather.dig("weather")&.first %>
<% if weather.present? %>
  <div class="w-full mt-8 bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
      <h2 class="text-xl font-semibold text-white">
        <%= [ city, state, country ].compact.join(", ") %>
      </h2>
      <p class="text-blue-100 text-sm">
        <%= weather.dig("description")&.titleize %>
      </p>
    </div>

    <div class="px-6 py-4">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-4">
          <div class="text-3xl font-bold text-gray-900">
            <%= current_weather.dig("main", "temp")&.round %>°F
          </div>
          <% if weather.dig("icon") %>
            <%= weather_icon(weather) %>
          <% end %>
        </div>
        <div class="text-right">
          <div class="text-sm text-gray-600">
            Feels like: <%= current_weather.dig("main", "feels_like")&.round %>°F
          </div>
          <div class="text-sm text-gray-600">
            Humidity: <%= current_weather.dig("main", "humidity") %>%
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <div class="text-gray-600">
          <span class="font-medium">High:</span> <%= current_weather.dig("main", "temp_max")&.round %>°F
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Low:</span> <%= current_weather.dig("main", "temp_min")&.round %>°F
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Sunrise:</span> <%= format_time(current_weather.dig("sys", "sunrise")) %>
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Sunset:</span> <%= format_time(current_weather.dig("sys", "sunset")) %>
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Wind:</span> <%= current_weather.dig("wind", "speed") %> mph
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Pressure:</span> <%= current_weather.dig("main", "pressure") %> hPa
        </div>
      </div>
    </div>
  </div>
<% end %>
