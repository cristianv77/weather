<% if weather_presenter.has_weather_data? %>
  <div class="w-full mt-8 bg-white shadow-lg rounded-lg overflow-hidden">
    <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
      <h2 class="text-xl font-semibold text-white">
        <%= weather_presenter.location %>
      </h2>
      <p class="text-blue-100 text-sm">
        <%= weather_presenter.description %>
      </p>
    </div>

    <div class="px-6 py-4">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-4">
          <div class="text-3xl font-bold text-gray-900">
            <%= weather_presenter.temperature_display %>
          </div>
          <%= weather_presenter.icon_display %>
        </div>
        <div class="text-right">
          <div class="text-sm text-gray-600">
            Feels like: <%= weather_presenter.feels_like_display %>
          </div>
          <div class="text-sm text-gray-600">
            Humidity: <%= weather_presenter.humidity_display %>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <div class="text-gray-600">
          <span class="font-medium">High:</span> <%= weather_presenter.temp_max_display %>
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Low:</span> <%= weather_presenter.temp_min_display %>
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Sunrise:</span> <%= weather_presenter.sunrise_display %>
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Sunset:</span> <%= weather_presenter.sunset_display %>
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Wind:</span> <%= weather_presenter.wind_speed_display %>
        </div>
        <div class="text-gray-600">
          <span class="font-medium">Pressure:</span> <%= weather_presenter.pressure_display %>
        </div>
      </div>
    </div>
  </div>
<% end %>
