<div class="container px-4 py-8 grid grid-cols-1 md:grid-cols-2 gap-8 min-h-screen">
  <div class="flex-1 md:sticky md:top-4 h-fit">
    <h1 class="text-3xl font-bold text-center mb-8">Weather App</h1>

    <div class="max-w-md mx-auto" data-controller="location">
      <%= form_with url: search_weather_path, method: :get, data: { turbo_stream: true } do |form| %>
        <div class="space-y-4">
          <div>
            <%= form.label :city, "City", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :city,
                placeholder: "e.g., New York",
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
                required: true %>
          </div>

          <div>
            <%= form.label :state, "State", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :state,
                placeholder: "e.g., New York",
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
                required: true %>
          </div>

          <div>
            <%= form.label :country, "Country", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :country,
                placeholder: "e.g., US",
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
                required: true %>
          </div>

          <%= form.submit "Get Weather",
              class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
        </div>
      <% end %>
    </div>

    <div class="max-w-md mx-auto mt-8 text-center text-gray-500">
      Enter a city, state, and country to get weather information
    </div>
  </div>

  <div class="flex-1">
    <%= turbo_frame_tag "weather_results" do %>
      <div></div>
    <% end %>
  </div>
</div>
